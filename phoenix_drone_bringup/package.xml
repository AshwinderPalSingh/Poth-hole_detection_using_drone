<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>phoenix_drone_bringup</name>
  <version>1.0.0</version>
  <description>
    Master bringup for PhoenixDrone simulation with Gazebo Classic 11.
    Launches world, drone model, flight controller, and RViz.
  </description>

  <maintainer email="dev@phoenix-drone.local">PhoenixDrone Dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>phoenix_drone_description</exec_depend>
  <exec_depend>phoenix_drone_gazebo</exec_depend>
  <exec_depend>phoenix_drone_control</exec_depend>
  <exec_depend>phoenix_drone_perception</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0" ?>
<model>
  <name>PhoenixDrone</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>PhoenixDrone Dev (based on utiasSTARS/PhoenixDrone)</name>
    <email>dev@phoenix-drone.local</email>

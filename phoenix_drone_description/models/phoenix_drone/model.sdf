<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="phoenix_drone">
    <static>false</static>
    <pose>0 0 0.15 0 0 0</pose>

    <!-- ==================== BASE LINK ==================== -->
    <link name="base_link">
      <!-- Mild damping keeps a single bad solver step from launching the
           body, and stands in for aerodynamic drag.
           NOTE: velocity_decay is applied PER PHYSICS STEP, so the effective
           damping rate is <linear> * step_rate.  At 500 Hz, 0.001 gives
           0.5 /s — enough to settle the solver, small enough that the drone
           can still reach its commanded cruise speed. -->
      <velocity_decay>
        <linear>0.001</linear>
        <angular>0.004</angular>
      </velocity_decay>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0347563</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0458929</iyy><iyz>0</iyz>
          <izz>0.0977</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box><size>0.47 0.47 0.11</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.6</mu><mu2>0.6</mu2></ode>
          </friction>
          <contact>
            <ode>
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="body_visual">
        <geometry>
          <box><size>0.47 0.47 0.11</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Arms -->
      <visual name="arm_front_left">
        <pose>0.17 0.17 0.02 0 0 0.785</pose>
        <geometry><box><size>0.30 0.03 0.02</size></box></geometry>
        <material><ambient>1 0.3 0 1</ambient><diffuse>1 0.3 0 1</diffuse></material>
      </visual>
      <visual name="arm_front_right">
        <pose>0.17 -0.17 0.02 0 0 -0.785</pose>
        <geometry><box><size>0.30 0.03 0.02</size></box></geometry>
        <material><ambient>1 0.3 0 1</ambient><diffuse>1 0.3 0 1</diffuse></material>
      </visual>
      <visual name="arm_rear_left">
        <pose>-0.17 0.17 0.02 0 0 -0.785</pose>
        <geometry><box><size>0.30 0.03 0.02</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="arm_rear_right">
        <pose>-0.17 -0.17 0.02 0 0 0.785</pose>
        <geometry><box><size>0.30 0.03 0.02</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- Rotor discs (visual only) -->
      <visual name="rotor_fl">
        <pose>0.25 0.25 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.5 0.5 0.5 0.4</ambient><diffuse>0.5 0.5 0.5 0.4</diffuse></material>
      </visual>
      <visual name="rotor_fr">
        <pose>0.25 -0.25 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.5 0.5 0.5 0.4</ambient><diffuse>0.5 0.5 0.5 0.4</diffuse></material>
      </visual>
      <visual name="rotor_rl">
        <pose>-0.25 0.25 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.5 0.5 0.5 0.4</ambient><diffuse>0.5 0.5 0.5 0.4</diffuse></material>
      </visual>
      <visual name="rotor_rr">
        <pose>-0.25 -0.25 0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
        <material><ambient>0.5 0.5 0.5 0.4</ambient><diffuse>0.5 0.5 0.5 0.4</diffuse></material>
      </visual>

      <!-- Landing gear legs -->
      <visual name="leg_fl">
        <pose>0.15 0.15 -0.08 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="leg_fr">
        <pose>0.15 -0.15 -0.08 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="leg_rl">
        <pose>-0.15 0.15 -0.08 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="leg_rr">
        <pose>-0.15 -0.15 -0.08 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>

      <visual name="lidar_visual">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0 0 0.8 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
      </visual>

      <!-- ===== SENSORS (mounted directly on base_link so the
           solver sees one rigid body, not five) ===== -->
      <sensor name="drone_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
          <frame_name>imu_link</frame_name>
          <ros>
            <namespace>/phoenix</namespace>
            <remapping>~/out:=imu/data</remapping>
          </ros>
        </plugin>
      </sensor>
      <sensor name="downward_camera" type="camera">
        <pose>0 0 -0.06 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/phoenix</namespace>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
      <sensor name="lidar" type="ray">
        <pose>0 0 0.08 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal>
            <samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
          </horizontal></scan>
          <range><min>0.2</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/phoenix</namespace>
            <remapping>~/out:=lidar/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
      <sensor name="gps_sensor" type="gps">
        <pose>0 0 0.10 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <gps>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0</mean><stddev>0.2</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0</mean><stddev>0.4</stddev></noise></vertical>
          </position_sensing>
        </gps>
        <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
          <ros>
            <namespace>/phoenix</namespace>
            <remapping>~/out:=gps/fix</remapping>
          </ros>
          <frame_name>gps_link</frame_name>
        </plugin>
      </sensor>
    </link>






    <!-- ==================== GROUND TRUTH ODOMETRY ==================== -->
    <plugin name="p3d_ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/phoenix</namespace>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>50</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0.001</gaussian_noise>
    </plugin>

  </model>
</sdf>

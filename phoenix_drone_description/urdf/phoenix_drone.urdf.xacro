<?xml version="1.0"?>
<!--
  phoenix_drone.urdf.xacro — URDF for robot_state_publisher
  ═════════════════════════════════════════════════════════════
  Provides the TF tree for RViz visualization. Defines the
  link/joint structure matching the Gazebo SDF model so that
  sensor data can be properly visualized in RViz.

  This is a simplified kinematic-only URDF — physics and
  sensors are handled by the Gazebo SDF model.
-->
<robot name="phoenix_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ════════════════════════════════ -->
  <!--  BASE LINK (drone body)         -->
  <!-- ════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.25 0.25 0.08"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.25 0.25 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.029125" ixy="0" ixz="0"
               iyy="0.029125" iyz="0"
               izz="0.055625"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════ -->
  <!--  BASE_FOOTPRINT (ground proj)   -->
  <!-- ════════════════════════════════ -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ════════════════════════════════ -->
  <!--  ROTOR ARMS                     -->
  <!-- ════════════════════════════════ -->

  <!-- Front-Right arm -->
  <link name="rotor_fr_link">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.246"/>
      </geometry>
      <material name="carbon">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="rotor_fr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_fr_link"/>
    <origin xyz="0.087 -0.087 0.01" rpy="0 1.5708 0.7854"/>
  </joint>

  <!-- Front-Left arm -->
  <link name="rotor_fl_link">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.246"/>
      </geometry>
      <material name="carbon">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="rotor_fl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_fl_link"/>
    <origin xyz="0.087 0.087 0.01" rpy="0 1.5708 -0.7854"/>
  </joint>

  <!-- Rear-Left arm -->
  <link name="rotor_rl_link">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.246"/>
      </geometry>
      <material name="carbon">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="rotor_rl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_rl_link"/>
    <origin xyz="-0.087 0.087 0.01" rpy="0 1.5708 0.7854"/>
  </joint>

  <!-- Rear-Right arm -->
  <link name="rotor_rr_link">
    <visual>
      <geometry>
        <cylinder radius="0.01" length="0.246"/>
      </geometry>
      <material name="carbon">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="rotor_rr_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_rr_link"/>
    <origin xyz="-0.087 -0.087 0.01" rpy="0 1.5708 -0.7854"/>
  </joint>

  <!-- ════════════════════════════════ -->
  <!--  CAMERA (downward-facing)       -->
  <!-- ════════════════════════════════ -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 -0.05" rpy="0 1.5708 0"/>
  </joint>

  <!-- Camera optical frame (Z forward, X right, Y down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ════════════════════════════════ -->
  <!--  LIDAR (2D planar scanner)      -->
  <!-- ════════════════════════════════ -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.2 0.6 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- ════════════════════════════════ -->
  <!--  IMU                            -->
  <!-- ════════════════════════════════ -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ════════════════════════════════ -->
  <!--  GPS                            -->
  <!-- ════════════════════════════════ -->
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

</robot>
